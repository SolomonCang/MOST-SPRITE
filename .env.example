SPRITE_APP_ENV=simulation
SPRITE_AUTH_MODE=dev
SPRITE_DATABASE_URL=postgresql+asyncpg://sprite:sprite@postgres:5432/sprite
SPRITE_REDIS_URL=redis://redis:6379/0
SPRITE_DATA_ROOT=/data
SPRITE_EMBEDDED_WORKERS=false
SPRITE_DEVICE_AGENT_TARGET=device-agent:50051
SPRITE_AUTO_CREATE_SCHEMA=true
SPRITE_SIMULATION_ROWS=256
SPRITE_SIMULATION_COLUMNS=256
SPRITE_PHYSICAL_ROWS=4096
SPRITE_PHYSICAL_COLUMNS=4096
SPRITE_PROCESSING_CLAIM_TIMEOUT_SECONDS=300
SPRITE_SOFTWARE_COMMIT=WORKTREE
# Production requires all of the following and AUTO_CREATE_SCHEMA=false:
# SPRITE_APP_ENV=production
# SPRITE_AUTH_MODE=oidc
# SPRITE_OIDC_ISSUER=https://identity.example.org
# SPRITE_OIDC_AUDIENCE=most-sprite
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
